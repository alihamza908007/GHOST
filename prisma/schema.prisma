generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Task {
  id               String            @id
  objective        String
  status           String
  currentStepIndex Int
  lastEventId      String?
  planJson         String?
  planSummary      String?
  plannerModel     String?
  error            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now()) @updatedAt
  events           TaskEvent[]
  evidence         Evidence[]
  approvals        ApprovalRequest[]
}

model TaskEvent {
  id        String   @id
  taskId    String
  type      String
  timestamp BigInt
  seq       Int      @default(0)
  data      String
  task      Task     @relation(fields: [taskId], references: [id])

  @@index([taskId, seq])
}

model ApprovalRequest {
  id          String   @id
  taskId      String
  stepIndex   Int
  actionJson  String
  status      String
  reason      String
  requestedAt BigInt
  decidedAt   BigInt?
  task        Task     @relation(fields: [taskId], references: [id])

  @@index([taskId, status])
}

model Evidence {
  id        String   @id
  taskId    String
  type      String
  filename  String
  size      Int
  timestamp BigInt
  task      Task     @relation(fields: [taskId], references: [id])

  @@index([taskId])
}
