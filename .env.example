# GHOST Phase 2 configuration
# All values are optional; the defaults below match the local demo setup.

# Local Ollama server. Only loopback URLs are accepted; remote inference is refused.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Exact planner model tag installed locally. GHOST never pulls models.
OLLAMA_PLANNER_MODEL=gpt-oss:20b

# Timeouts (milliseconds)
OLLAMA_TIMEOUT_MS=45000
GHOST_EXECUTION_TIMEOUT_MS=120000
GHOST_ACTION_TIMEOUT_MS=15000
GHOST_MODEL_PROBE_CACHE_MS=60000

# Exact demo origin allowed for navigation. Scheme, host and port must match.
GHOST_DEMO_ORIGIN=http://127.0.0.1:3001

# GHOST API port and dashboard origins allowed through CORS.
GHOST_PORT=3002
GHOST_DASHBOARD_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Evidence directory (screenshots). Relative paths resolve from the server cwd.
EVIDENCE_DIR=./evidence_store

# Optional: force a Playwright Chromium channel (e.g. chrome, msedge).
# PLAYWRIGHT_CHROMIUM_CHANNEL=chrome

# Dashboard API base URL (Next.js public env variable).
NEXT_PUBLIC_GHOST_API_URL=http://localhost:3002

# Explicit opt-in for the real-model integration test (never enabled in CI).
# GHOST_RUN_OLLAMA_INTEGRATION=1
